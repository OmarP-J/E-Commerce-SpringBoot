SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:sqlserver://TU_SERVIDOR.database.windows.net:1433;databaseName=TU_BASE;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30
DB_USERNAME=USUARIO_SQL
DB_PASSWORD=CAMBIAR_POR_UN_SECRETO
CLIENT_ORIGIN=https://TU_FRONTEND.example.com
JWT_SECRET=BASE64_DE_32_BYTES_ALEATORIOS
APP_ADMIN_EMAIL=admin@TU_DOMINIO.com
APP_ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LARGA
APP_ADMIN_NAME=Administrador

# --- Pasarelas de pago (todo en modo prueba: nunca cobra dinero real) ---
# TEST desactiva automaticamente cualquier pasarela con llaves de produccion.
PAYMENTS_MODE=TEST
# PayPal y Stripe no aceptan DOP; el monto se envia en esta moneda.
PAYMENTS_CURRENCY=USD
# Deja disponible el pago sin pasarela. Ponlo en false en una tienda real.
PAYMENTS_SIMULATED=true
# URL publica del frontend, para el retorno de Stripe.
PAYMENTS_RETURN_URL=https://TU_FRONTEND.example.com

# PayPal: credenciales del sandbox (developer.paypal.com > Apps & Credentials)
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Stripe: llaves de prueba (dashboard.stripe.com, empiezan con sk_test_ / pk_test_)
STRIPE_ENABLED=false
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# --- Correo (Brevo, 300 envios diarios gratis) ---
# Con MAIL_ENABLED=false el registro funciona como antes: sin codigo.
MAIL_ENABLED=false
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Esencial
BREVO_API_KEY=
# Verificacion de la cuenta por codigo (solo aplica si el correo esta activo)
VERIFICATION_ENABLED=true
VERIFICATION_EXPIRY_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN=60
VERIFICATION_CHECK_MX=true
