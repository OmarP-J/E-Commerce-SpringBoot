# ---------------------------------------------------------------------------
# Copia este archivo a .env y rellena los valores reales.
#   cp .env.example .env && nano .env
# NUNCA subas el .env a GitHub (ya está en .gitignore).
#
# OJO con el signo de dólar: Docker Compose interpreta $ como variable.
# Si tu contraseña o tu JWT_SECRET contiene un $, escríbelo DOBLE en este
# archivo. Ejemplo: la contraseña  Abc$123  se escribe  Abc$$123
# ---------------------------------------------------------------------------

# Dominio con el que Caddy pedirá el certificado HTTPS.
# Sin dominio propio usa sslip.io con la IP de la VM y guiones en vez de puntos:
#   IP 140.238.170.12  ->  SITE_ADDRESS=140-238-170-12.sslip.io
SITE_ADDRESS=

# --- Azure SQL (copia estos 3 valores tal cual los tienes hoy en Render) ---
DB_URL=jdbc:sqlserver://esencial-ecommerce-sql.database.windows.net:1433;databaseName=ecommerce;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30
DB_USERNAME=ecommerce_app
DB_PASSWORD=

# --- Seguridad ---
# Copia el MISMO valor que ya tiene Render, así las sesiones abiertas siguen siendo válidas.
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma.
CLIENT_ORIGIN=https://esencial-tienda.vercel.app

# --- Opcional: tamaño del pool de conexiones ---
DB_POOL_SIZE=5
DB_MIN_IDLE=1

# --- Opcional: solo si necesitas volver a crear el admin inicial ---
# Déjalas vacías si tu cuenta de administrador ya existe en la base.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
APP_ADMIN_NAME=
